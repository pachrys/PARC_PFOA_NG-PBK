    <listOfRules>
      <assignmentRule variable="Intestine_lumen">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <ci> VIntestine_lumen </ci>
        </math>
      </assignmentRule>
      <assignmentRule variable="Intestine_tissue">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <ci> VIntestine_tissue </ci>
        </math>
      </assignmentRule>
      <assignmentRule variable="Liver_extracellular">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <ci> VLiver_extracellular </ci>
        </math>
      </assignmentRule>
      <assignmentRule variable="Liver_intracellular">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <ci> VLiver_intracellular </ci>
        </math>
      </assignmentRule>
      <assignmentRule variable="Plasma">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <ci> VPlasma </ci>
        </math>
      </assignmentRule>
      <assignmentRule variable="Kidney_proximal_tubule_tissue">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <ci> VKidney_proximal_tubule_tissue </ci>
        </math>
      </assignmentRule>
      <assignmentRule variable="Kidney_proximal_tubule_lumen">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <ci> VKidney_proximal_tubule_lumen </ci>
        </math>
      </assignmentRule>
      <assignmentRule variable="Kidney_rest_tissue">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <ci> VKidney_rest_tissue </ci>
        </math>
      </assignmentRule>
      <assignmentRule variable="Kidney_rest_lumen">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <ci> VKidney_rest_lumen </ci>
        </math>
      </assignmentRule>
      <assignmentRule variable="Adipose">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <ci> VAdipose </ci>
        </math>
      </assignmentRule>
      <assignmentRule variable="Rest">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <ci> VRest </ci>
        </math>
      </assignmentRule>
      <assignmentRule variable="VIntestine_lumen">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <times/>
            <ci> VIntestine_lumenc </ci>
            <ci> BW </ci>
          </apply>
        </math>
      </assignmentRule>
      <assignmentRule variable="VIntestine_tissue">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <times/>
            <ci> VIntestine_tissuec </ci>
            <ci> BW </ci>
          </apply>
        </math>
      </assignmentRule>
      <assignmentRule variable="VLiver_extracellular">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <times/>
            <ci> VLiver </ci>
            <apply>
              <minus/>
              <cn type="integer"> 1 </cn>
              <cn> 0.573 </cn>
            </apply>
          </apply>
        </math>
      </assignmentRule>
      <assignmentRule variable="VLiver_intracellular">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <times/>
            <ci> VLiver </ci>
            <cn> 0.573 </cn>
          </apply>
        </math>
      </assignmentRule>
      <assignmentRule variable="VPlasma">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <times/>
            <ci> VBloodc </ci>
            <apply>
              <minus/>
              <cn type="integer"> 1 </cn>
              <ci> HCT </ci>
            </apply>
            <ci> BW </ci>
          </apply>
        </math>
      </assignmentRule>
      <assignmentRule variable="VKidney_proximal_tubule_tissue">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <times/>
            <cn> 0.398 </cn>
            <ci> VKidney </ci>
            <apply>
              <plus/>
              <apply>
                <times/>
                <cn> 0.137 </cn>
                <apply>
                  <minus/>
                  <cn type="integer"> 1 </cn>
                  <ci> HCT </ci>
                </apply>
              </apply>
              <cn> 0.46 </cn>
            </apply>
          </apply>
        </math>
      </assignmentRule>
      <assignmentRule variable="VKidney_proximal_tubule_lumen">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <times/>
            <cn> 0.398 </cn>
            <ci> VKidney </ci>
            <cn> 0.403 </cn>
          </apply>
        </math>
      </assignmentRule>
      <assignmentRule variable="VKidney_rest_tissue">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <minus/>
            <apply>
              <minus/>
              <apply>
                <minus/>
                <ci> VKidney </ci>
                <ci> VKidney_proximal_tubule_tissue </ci>
              </apply>
              <ci> VKidney_proximal_tubule_lumen </ci>
            </apply>
            <ci> VKidney_rest_lumen </ci>
          </apply>
        </math>
      </assignmentRule>
      <assignmentRule variable="VKidney_rest_lumen">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <times/>
            <apply>
              <minus/>
              <ci> VKidney </ci>
              <apply>
                <times/>
                <cn> 0.398 </cn>
                <ci> VKidney </ci>
              </apply>
            </apply>
            <cn> 0.283 </cn>
          </apply>
        </math>
      </assignmentRule>
      <assignmentRule variable="VAdipose">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <plus/>
            <apply>
              <divide/>
              <apply>
                <times/>
                <ci> VAdiposec </ci>
                <ci> BW </ci>
              </apply>
              <cn> 0.9 </cn>
            </apply>
            <apply>
              <divide/>
              <ci> MAc </ci>
              <cn> 0.9 </cn>
            </apply>
          </apply>
        </math>
      </assignmentRule>
      <assignmentRule variable="VRest">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <minus/>
            <apply>
              <times/>
              <cn> 0.94 </cn>
              <ci> BW </ci>
            </apply>
            <apply>
              <plus/>
              <ci> VIntestine_tissue </ci>
              <ci> VLiver </ci>
              <ci> VKidney </ci>
              <ci> VAdipose </ci>
              <ci> VPlasma </ci>
            </apply>
          </apply>
        </math>
      </assignmentRule>
      <assignmentRule variable="BW">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <cn type="integer"> 82 </cn>
        </math>
      </assignmentRule>
      <assignmentRule variable="QC">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <cn> 4919.541 </cn>
        </math>
      </assignmentRule>
      <assignmentRule variable="HCT">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <cn> 0.427 </cn>
        </math>
      </assignmentRule>
      <assignmentRule variable="QIntestine">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <times/>
            <apply>
              <divide/>
              <ci> QIntestinec </ci>
              <cn> 0.96 </cn>
            </apply>
            <ci> QC </ci>
          </apply>
        </math>
      </assignmentRule>
      <assignmentRule variable="QIntestinec">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <times/>
            <apply>
              <divide/>
              <ci> VIntestine_tissuec </ci>
              <cn> 0.014 </cn>
            </apply>
            <cn> 0.144 </cn>
          </apply>
        </math>
      </assignmentRule>
      <assignmentRule variable="VKidney">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <times/>
            <ci> VKidneyc </ci>
            <ci> BW </ci>
          </apply>
        </math>
      </assignmentRule>
      <assignmentRule variable="VKidneyc">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <cn> 0.00421 </cn>
        </math>
      </assignmentRule>
      <assignmentRule variable="QKidney">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <times/>
            <apply>
              <divide/>
              <ci> QKidneyc </ci>
              <cn> 0.96 </cn>
            </apply>
            <ci> QC </ci>
          </apply>
        </math>
      </assignmentRule>
      <assignmentRule variable="QKidneyc">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
